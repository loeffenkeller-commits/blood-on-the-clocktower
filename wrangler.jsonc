{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blood-on-the-clocktower",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
